function formatHTMLPrices(html) {         
  return html.replace(/(\d+(?:[.,]\d{3})*(?:[.,]\d+)?)(?:\s*TL)/g, m => {
    // Sadece say&#305;y&#305; al, TL'yi at         
    let numOnly = m.replace(/TL/i, '').trim();
    return formatTL(numOnly);             
  });                                     
}                                         
                                          
function formatTL(value) {                
  let num = value.toString()              
    .replace(/./g, '')   // binlik nokta sil
    .replace(',', '.');   // ondal&#305;k , ? .
                                          
  let number = parseFloat(num);           
  if (isNaN(number)) return value;        
                                          
  return number.toLocaleString('tr-TR', { style: 'currency', currency: 'TRY' });
}                                         
                                          
                                          
                                          
                                          
