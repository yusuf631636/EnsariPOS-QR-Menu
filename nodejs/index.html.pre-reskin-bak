  /* ----------------- Fiyatlar&#305; TL formatla ----------------- */
  const fmtTRY = new Intl.NumberFormat('tr-TR', {style:'currency', currency:'TRY', minimumFractionDigits:2});
                                          
function parseMoney(str) {                
  if (typeof str !== 'string') return null;
                                          
  // Sadece rakam, virg&uuml;l, nokta ve eksi i&#351;aretini al
  const cleaned = str.replace(/[^\d.,-]/g, '').trim();
  if (!cleaned) return null;              
                                          
  // E&#287;er hem nokta hem virg&uuml;l varsa ? binlik noktalar&#305; kald&#305;r, virg&uuml;l&uuml; nokta yap
  if (cleaned.includes('.') && cleaned.includes(',')) {
    return Number(cleaned.replace(/\.(?=\d{3}(,|$))/g, '').replace(',', '.'));
  }                                       
                                          
  // E&#287;er sadece virg&uuml;l varsa ? ondal&#305;k i&ccedil;in virg&uuml;l&uuml; nokta yap
  if (!cleaned.includes('.') && cleaned.includes(',')) {
    return Number(cleaned.replace(',', '.'));
  }                                       
                                          
  // Sadece say&#305; veya nokta varsa ? direkt numaraya &ccedil;evir
  return Number(cleaned);                 
}                                         
                                          
  function formatTL(x){                   
    if(typeof x==='number') return fmtTRY.format(x);
    const n = parseMoney(x);              
    return (n===null)? x : fmtTRY.format(n);
  }                                       
  function formatAllPriceTags(){          
    document.querySelectorAll('.price-tag').forEach(el=>{
      el.textContent = formatTL(el.textContent);
    });                                   
  }                                       
                                          
  /* ----------------- Swipe ile kategori (i&ccedil;erikte) ----------------- */
  let startX=0, startY=0;                 
  document.body.addEventListener('touchstart', e=>{
    startX = e.touches[0].clientX;        
    startY = e.touches[0].clientY;        
  }, {passive:true});                     
                                          
  document.body.addEventListener('touchend', e=>{
    if(searchTerm) return;
    const endX = e.changedTouches[0].clientX;
    const endY = e.changedTouches[0].clientY;
    const diffX = startX - endX;
    const diffY = startY - endY;
    if(Math.abs(diffX) > Math.abs(diffY) && Math.abs(diffX) > 50){
      if(diffX > 0 && currentIndex < sections.length - 1){
        showCategory(sections[currentIndex + 1]);
      } else if(diffX < 0 && currentIndex > 0){
        showCategory(sections[currentIndex - 1]);
      }                                   
    }                                     
  }, {passive:true});                     
                                          
  /* ----------------- Init ----------------- */
  window.addEventListener('load', ()=>{   
    buildHomeGrid();                      
    buildDrawer();                        
    formatAllPriceTags();                 
  });                                     
                                          
                                          
