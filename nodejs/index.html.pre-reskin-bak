/* ARAMA */
let searchTerm = '';
const searchInput = document.getElementById('searchInput');
const searchWrap = document.getElementById('searchWrap');
const searchClear = document.getElementById('searchClear');
let searchTimer;
searchInput.addEventListener('input', e => {
  clearTimeout(searchTimer);
  const v = e.target.value.trim();
  searchWrap.classList.toggle('has-text', !!v);
  searchTimer = setTimeout(() => { searchTerm = v; applySearch(); }, 180);
});
searchClear.onclick = () => {
  searchInput.value = '';
  searchTerm = '';
  searchWrap.classList.remove('has-text');
  applySearch();
};
function applySearch() {
  if (!searchTerm) {
    document.querySelectorAll('.menu-section').forEach(s => {
      s.style.display = '';
      s.classList.toggle('active', s.id === (sections[currentIndex] || 'anasayfa'));
    });
    const strip = document.getElementById('featuredStrip');
    if (strip) strip.style.display = '';
    const emptyEl = document.getElementById('searchEmpty');
    if (emptyEl) emptyEl.style.display = 'none';
    return;
  }
  const q = searchTerm.toLocaleLowerCase('tr-TR');
  let anyMatch = false;
  document.querySelectorAll('.menu-section').forEach(section => {
    if (section.id === 'anasayfa') { section.style.display = 'none'; return; }
    let visible = 0;
    section.querySelectorAll('.menu-item').forEach(item => {
      const name = (item.querySelector('strong')?.textContent || '').toLocaleLowerCase('tr-TR');
      const desc = (item.querySelector('small')?.textContent || '').toLocaleLowerCase('tr-TR');
      const match = name.includes(q) || desc.includes(q);
      item.style.display = match ? '' : 'none';
      if (match) visible++;
    });
    section.style.display = visible ? 'block' : 'none';
    section.classList.toggle('active', visible > 0);
    if (visible) anyMatch = true;
  });
  const strip = document.getElementById('featuredStrip');
  if (strip) strip.style.display = 'none';
  if (!anyMatch) {
    let emptyEl = document.getElementById('searchEmpty');
    if (!emptyEl) {
      emptyEl = document.createElement('div');
      emptyEl.id = 'searchEmpty';
      emptyEl.className = 'empty-state';
      emptyEl.innerHTML = '<div>🔍</div>Sonuç bulunamadı.';
      document.body.appendChild(emptyEl);
    }
    emptyEl.style.display = '';
  } else {
    const emptyEl = document.getElementById('searchEmpty');
    if (emptyEl) emptyEl.style.display = 'none';
  }
}                                         
                                          
                                          
