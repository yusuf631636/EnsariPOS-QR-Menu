  function toggleDrawer(force){           
    if(typeof force==='boolean'){         
      document.body.classList.toggle('drawer-open', force);
      return;                             
    }                                     
    document.body.classList.toggle('drawer-open');
  }                                       
  document.getElementById('btnDrawer').addEventListener('click', ()=>toggleDrawer());
                                          
  /* Sa&#287;dan kayd&#305;rma ile drawer a&ccedil;/kapat */
  let tStartX=0,tStartY=0, tDragging=false, fromEdge=false;
  document.body.addEventListener('touchstart', e=>{
    if(!e.touches || !e.touches[0]) return;
    tStartX = e.touches[0].clientX;       
    tStartY = e.touches[0].clientY;       
    fromEdge = (window.innerWidth - tStartX) < 24; // sa&#287; kenardan ba&#351;l&#305;yorsa
    tDragging = true;                     
  }, {passive:true});                     
                                          
  document.body.addEventListener('touchmove', e=>{
    if(!tDragging) return;                
    const dx = e.touches[0].clientX - tStartX;
    const dy = e.touches[0].clientY - tStartY;
    // yatay belirgin ve kenardan ba&#351;lad&#305;ysa
    if(fromEdge && Math.abs(dx) > Math.abs(dy) && dx < -40){
      toggleDrawer(true);                 
      tDragging=false;                    
    }                                     
    // drawer a&ccedil;&#305;kken sola kayd&#305;rma ile kapat
    if(document.body.classList.contains('drawer-open') && Math.abs(dx) > Math.abs(dy) && dx > 40){
      toggleDrawer(false);                
      tDragging=false;                    
    }                                     
  }, {passive:true});                     
  document.body.addEventListener('touchend', ()=>{ tDragging=false; });
                                          
