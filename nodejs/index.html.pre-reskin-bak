<script>
  /* Ürün rozetleri (öne çıkan/yeni/indirimli) + alt kategori etiketi -
     admin panelinden eklenen data-badges/data-subcat/data-oldprice
     özniteliklerini okuyup görsel rozete çevirir (bkz. menu-editor.js,
     CSS: .qm-badge/.qm-subcat/.qm-oldprice). Sayfanın statik HTML'ine hiç
     dokunmaz, sadece DOM'a ekleme yapar - mevcut kart yapısı bozulmaz. */
  var BADGE_LABEL = { featured: '⭐ Öne Çıkan', new: '🆕 Yeni', discount: '🏷️ İndirimli' };
  function decorateBadges() {
    document.querySelectorAll('.menu-item').forEach(function (card) {
      if (card.dataset.qmDecorated) return;
      card.dataset.qmDecorated = '1';
      var textCol = card.querySelector('.menu-content > div:last-child');
      if (!textCol) return;
      var badges = (card.getAttribute('data-badges') || '').split(',').filter(Boolean);
      var subcat = card.getAttribute('data-subcat') || '';
      var oldPrice = card.getAttribute('data-oldprice') || '';
      if (subcat) {
        var chip = document.createElement('span');
        chip.className = 'qm-subcat';
        chip.textContent = subcat;
        textCol.insertBefore(chip, textCol.firstChild);
      }
      if (badges.length) {
        var row = document.createElement('div');
        row.className = 'qm-badges';
        badges.forEach(function (b) {
          if (!BADGE_LABEL[b]) return;
          var span = document.createElement('span');
          span.className = 'qm-badge ' + b;
          span.textContent = BADGE_LABEL[b];
          row.appendChild(span);
        });
        textCol.insertBefore(row, textCol.firstChild);
      }
      if (oldPrice) {
        var priceTag = card.querySelector('.price-tag');
        if (priceTag && !priceTag.querySelector('.qm-oldprice')) {
          var s = document.createElement('span');
          s.className = 'qm-oldprice';
          s.textContent = oldPrice;
          priceTag.insertBefore(s, priceTag.firstChild);
        }
      }
    });
    buildFeaturedStrip();
  }
  /* "Öne Çıkan" işaretli ürünleri kategori seçmeye gerek olmadan doğrudan
     Ana Sayfa'nın en üstünde gösterir (kullanıcı isteği: "öne çıkan etiketi
     seçilince sayfada direkt onu göstersin, kategori zorunlu olmasın"). */
  function buildFeaturedStrip() {
    var strip = document.getElementById('featuredStrip');
    var list = document.getElementById('featuredList');
    if (!strip || !list) return;
    var items = Array.prototype.slice.call(document.querySelectorAll('.menu-item[data-badges]'))
      .filter(function (el) { return (el.getAttribute('data-badges') || '').split(',').indexOf('featured') !== -1; });
    if (!items.length) { strip.style.display = 'none'; return; }
    list.innerHTML = '';
    items.forEach(function (el) {
      var clone = el.cloneNode(true);
      clone.style.flex = '0 0 200px';
      clone.style.margin = '0';
      list.appendChild(clone);
    });
    strip.style.display = '';
  }
  window.addEventListener('load', decorateBadges);
  // showCategory/drawer gecisleri kartlari yeniden olusturmuyor (ayni statik
  // DOM), ama guvenlik icin kategori degisiminde de bir kez daha calistir.
  document.addEventListener('click', function (e) {
    if (e.target && e.target.closest && e.target.closest('[data-id]')) setTimeout(decorateBadges, 50);
  });
  if ('serviceWorker' in navigator) navigator.serviceWorker.register('/sw.js').catch(function(){});
</script>
